rules_version = '2';

// Regras de acesso do BarberPro.
// Princípio: tudo negado por padrão; cada coleção libera apenas o necessário.
// Dono/admin = existe um documento em admins/{uid} (criado manualmente no console).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Documento pertence ao usuário logado (campo clienteUid).
    function ehDoUsuario(d) {
      return signedIn() && ('clienteUid' in d) && d.clienteUid == request.auth.uid;
    }

    // Reserva anônima (clienteUid nulo) ou do próprio usuário logado.
    function donoOuAnonimo(d) {
      return !('clienteUid' in d) || d.clienteUid == null || (signedIn() && d.clienteUid == request.auth.uid);
    }

    function reservaValida(d) {
      return d.keys().hasAll(['clienteUid', 'name', 'phone', 'service', 'date', 'time', 'status', 'createdAt'])
        && d.status == 'pending'
        && donoOuAnonimo(d)
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.service is string && d.service.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500))
        && (!('price' in d) || d.price is number);
    }

    // Espelho público de horário: o ID do documento DEVE ser data_hora(_barbeiro).
    // Como o ID é determinístico e só pode ser criado (ou recriado se estiver cancelado),
    // dois clientes não conseguem ocupar o mesmo horário.
    function espelhoValido(d, id) {
      return d.keys().hasAll(['date', 'time', 'status'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.status in ['pending', 'confirmed', 'done', 'cancelled']
        && id == d.date + '_' + d.time + (('barberId' in d && d.barberId != null) ? '_' + d.barberId : '')
        && donoOuAnonimo(d);
    }

    // ── Admins: ficha do dono. Criada só pelo console (Admin SDK). ──
    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow update: if signedIn() && request.auth.uid == uid && isAdmin();
      allow create, delete: if false;
    }

    // ── Configurações públicas (leitura livre; escrita só do dono). ──
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Catálogo público (leitura livre; escrita só do dono). ──
    match /servicos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /barbeiros/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galeria/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Perfil do cliente: dados pessoais. Só o próprio cliente e o dono. ──
    match /clientes/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── Agendamentos: dados pessoais do cliente. ──
    match /agendamentos/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.clienteUid == request.auth.uid);
      allow create: if reservaValida(request.resource.data);
      // Cliente só pode cancelar o próprio agendamento pendente/confirmado, alterando apenas o status.
      allow update: if isAdmin() || (
        ehDoUsuario(resource.data)
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    // ── Espelho público de horários ocupados (sem dados pessoais). ──
    match /disponibilidade/{id} {
      allow read: if true;
      allow create: if isAdmin() || (espelhoValido(request.resource.data, id) && request.resource.data.status == 'pending');
      // Reocupar um horário só é permitido se ele estiver cancelado (ou pelo dono).
      allow update: if isAdmin() || (
        resource.data.status == 'cancelled'
        && espelhoValido(request.resource.data, id)
        && request.resource.data.status == 'pending'
      );
      // O cliente libera o próprio horário ao cancelar.
      allow delete: if isAdmin() || ehDoUsuario(resource.data);
    }

    // Tudo que não está listado acima fica negado.
  }
}
